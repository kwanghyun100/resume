# 로컬은 비워두면 ./resume.db (SQLite) 사용
# Vercel: Supabase > Project Settings > Database > Connection pooling (Transaction, 포트 6543) URL
DATABASE_URL=
# 세션 쿠키 서명 키 (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# 선택: 있으면 [지금 상황 3줄 요약] 버튼이 보임
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# 선택: Vercel Cron 인증용 (Vercel이 Authorization: Bearer 로 자동 전송)
CRON_SECRET=
